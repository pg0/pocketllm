# Copy to keystore.properties and fill in. That file is gitignored.
#
# storeFile must use forward slashes even on Windows: this is a Java
# properties file, where a backslash starts an escape sequence and
# C:\Users would be read as an invalid \U unicode escape.
storeFile=C:/path/to/pocketllm-release.jks
storePassword=
keyAlias=pocketllm
keyPassword=
