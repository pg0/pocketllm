# PocketLLM builds need no secrets today: both model repos on Hugging Face are
# ungated, so downloads are unauthenticated.
#
# Kept as a placeholder for the roadmap items that will need keys.

# Only required if a gated model repo is added to ModelCatalog.
HF_TOKEN=

# Web search backend (roadmap - see docs/roadmap.md).
# SEARCH_PROVIDER=searxng|brave|ddg
# SEARXNG_URL=
# BRAVE_API_KEY=

# Release signing (referenced from keystore.properties, never committed).
# KEYSTORE_PATH=
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
